<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The host's LaunchAgent (plan section 6, process model). The build copies it into
  Contents/Library/LaunchAgents/BUNDLE_ID.agent.plist with the placeholders filled in, and the app
  registers it with SMAppService.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>BUNDLE_ID.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/EXECUTABLE</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>BUNDLE_ID</string>
	</array>
	<!-- Starts at login. -->
	<key>RunAtLoad</key>
	<true/>
	<!-- Relaunched after a crash, or after the app exits on purpose to restart. Quit stays quit. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<!-- Only in a logged-in graphical session. -->
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<!-- Tells the app it is the copy launchd runs. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>FARSIDE_AGENT</key>
		<string>1</string>
	</dict>
</dict>
</plist>
