# Copy to .env on the server (make server-deploy makes it from this, with fresh secrets).
# Never commit the real one.
FARSIDE_DOMAIN=api.example.com
APP_NAME=Farside
APP_URL=https://api.example.com
APP_KEY=
DB_PASSWORD=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The apps' bundle identifiers.
APPLE_AUDIENCES=com.example.farside.client,com.example.farside.host
# Cloudflare Realtime TURN: Dashboard > Realtime > TURN Server > Create. Paste them here yourself.
TURN_PROVIDER=cloudflare
TURN_TTL=43200
STUN_URLS=stun:stun.cloudflare.com:3478
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
